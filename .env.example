# Penny Windows CAD/CAE Worker (.env)
# Copy this file to .env on the Windows VM

# Bind address and port (recommend binding to Tailscale IP or 0.0.0.0 behind firewall)
WORKER_HOST=0.0.0.0
WORKER_PORT=8085

# Shared Bearer token (must match WIN_WORKER_TOKEN / SAP2000_WORKER_TOKEN on Penny_COS_Bot)
WORKER_TOKEN=

# CSI SAP2000 v25 installation directory containing SAP2000v1.dll
SAP2000_DIR=C:\Program Files\Computers and Structures\SAP2000 25
SAP2000_EXEC_TIMEOUT=280

# AutoCAD / ODA File Converter settings
ODA_CONVERTER_PATH=C:\Program Files\ODA\ODAFileConverter 25.12.0\ODAFileConverter.exe
AUTOCAD_EXEC_TIMEOUT=180
